{
	"name": "server",
	"version": "1.0.0",
	"description": "Uniplanet BackEnd Server",
	"main": "index.ts",
	"scripts": {
		"lint": "eslint src",
		"lint:staged": "lint-staged",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"start": "NODE_ENV=production ts-node src/index.ts",
		"dev": "NODE_ENV=production nodemon src/index.ts",
		"test": "jest --verbose --forceExit --detectOpenHandles",
		"test:watch": "jest --verbose --watchAll --no-cache --runInBand --detectOpenHandles",
		"tsc:check": "tsc --noEmit"
	},
	"jest": {
		"testEnvironment": "node",
		"preset": "ts-jest",
		"setupFilesAfterEnv": [
			"./src/test_util/setup_files_after_env.ts"
		]
	},
	"author": "Sije Park",
	"license": "ISC",
	"dependencies": {
		"@socket.io/redis-emitter": "5.1.0",
		"cors": "2.8.6",
		"crypto-ts": "1.0.2",
		"dotenv-safe": "9.1.0",
		"express": "4.22.3",
		"express-async-errors": "3.1.1",
		"express-validator": "7.3.2",
		"generate-password": "1.7.1",
		"googleapis": "129.0.0",
		"http": "0.0.1-security",
		"ioredis": "5.11.1",
		"jsonwebtoken": "9.0.2",
		"mongodb-memory-server": "9.5.0",
		"mongoose": "8.0.3",
		"node-cron": "3.0.3",
		"nodemailer": "6.10.1",
		"otp-generator": "4.0.1",
		"redis": "4.7.1",
		"socket.io": "4.8.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "2.4.6",
		"@types/dotenv-safe": "9.1.0",
		"@types/express": "4.17.25",
		"@types/jest": "29.5.14",
		"@types/jsonwebtoken": "9.0.7",
		"@types/node": "20.19.43",
		"@types/node-cron": "3.0.11",
		"@types/nodemailer": "6.4.24",
		"@types/otp-generator": "4.0.2",
		"@types/redis": "4.0.11",
		"@types/supertest": "2.0.16",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"eslint": "8.57.1",
		"eslint-config-airbnb-typescript": "17.1.0",
		"eslint-config-prettier": "9.1.2",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-prettier": "5.5.6",
		"jest": "29.7.0",
		"lint-staged": "15.5.2",
		"mongodb-memory-server": "9.5.0",
		"nodemon": "3.1.14",
		"prettier": "3.9.5",
		"supertest": "6.3.4",
		"ts-jest": "29.4.13",
		"ts-node": "10.9.2",
		"typescript": "5.5.4"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"npm run prettier:fix",
			"npm run lint",
			"git add"
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged && npm run test"
		}
	}
}
